<UserControl x:Class="Main_Window.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Main_Window.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="609" d:DesignWidth="62"
             Background="#0C0C0F">

    <UserControl.Resources>
        <!-- Font Family -->
        <FontFamily x:Key="Montserrat">pack://application:,,,/Fonts/Montserrat-Regular.ttf</FontFamily>

        <!-- Radio Button Style -->
        <Style x:Key="IconRadioButton" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}">

                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform x:Name="iconScale"
                                            ScaleX="1"
                                            ScaleY="1"
                                            CenterX="8.5"
                                            CenterY="8.5"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.2" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.2" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style x:Key="IconButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">

                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform x:Name="iconScale"
                                ScaleX="1"
                                ScaleY="1"
                                CenterX="8.5"
                                CenterY="8.5"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1.2" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1.2" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer Button Style -->
        <Style x:Key="SmallIconButton" BasedOn="{StaticResource IconButton}" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="59"/>
            <RowDefinition Height="94"/>
            <RowDefinition Height="94"/>
            <RowDefinition Height="94"/>
            <RowDefinition/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Image Grid.Column="0"
               Source="/Images/Logo.png"
               Margin="9,0,9,0"
               VerticalAlignment="Center" Height="90"/>

        <!-- Navigation Buttons -->
        <Button Grid.Column="0"
                Grid.Row="1"
                Margin="20,18,17,16"
                Style="{StaticResource IconButton}"
                Click="LaunchFirefox_Click">
                    <Image Source="/Images/Search.png" Width="17.6" Height="17.6"/>
        </Button>

        <!-- Navigation Divider -->
        <Border Background="#1A1A1C"
                BorderBrush="#1A1A1C"
                BorderThickness="1.5"
                Width="42"
                Height="3"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Grid.Row="1"
                Margin="0,56,0,0"/>

        <!-- Group 1: Home & Library-->
        <UniformGrid Columns="1"
                     Rows="2" Grid.Column="0"
                     Grid.Row="2"
                     VerticalAlignment="Center"
                     Height="78">

            <RadioButton x:Name="HomeButton"
                         Style="{StaticResource IconRadioButton}"
                         Click="HomeButton_Click">
                             <Image Source="/Images/Home.png" Width="17" Height="17"/>
            </RadioButton>

            <RadioButton x:Name="LibraryButton"
                         Style="{StaticResource IconRadioButton}"
                         Click="LibraryButton_Click">
                             <Image Source="/Images/Library.png" Width="15" Height="15"/>
            </RadioButton>
        </UniformGrid>

        <!-- Navigation Divider -->
        <Border Background="#1A1A1C"
                BorderBrush="#1A1A1C"
                BorderThickness="1.5" Width="42"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Grid.Row="2" Height="3" Margin="0,91,0,0"/>

        <!-- Group 2: Shop & Wishlist -->
        <UniformGrid Columns="1"
                     Rows="2"
                     Grid.Column="0"
                     Grid.Row="3"
                     VerticalAlignment="Center"
                     Height="78">

            <Button x:Name="ShopButton"
                    Style="{StaticResource IconButton}"
                    Click="LaunchSteam_Click">
                        <Image Source="/Images/Shop.png" Width="17" Height="17"/>
            </Button>

            <Button x:Name="WishlistButton"
                    Style="{StaticResource IconButton}">
                        <Image Source="/Images/Wishlist.png" Width="17" Height="17"/>
            </Button>
        </UniformGrid>

        <!-- Navigation Divider -->
        <Border Background="#1A1A1C"
                BorderBrush="#1A1A1C"
                BorderThickness="1.5" Width="42"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Grid.Row="3" Height="3" Margin="0,91,0,0"/>

        <!-- Group 3: Friends & Messages -->
        <UniformGrid Columns="1"
                     Rows="2"
                     Grid.Column="0"
                     Grid.Row="4"
                     VerticalAlignment="Center"
                     Height="78">

            <Button x:Name="FriendsButton"
                    Style="{StaticResource IconButton}">
                        <Image Source="/Images/Friends.png" Width="17" Height="17"/>
            </Button>

            <Button x:Name="MessagesButton"
                    Style="{StaticResource IconButton}"
                    Click="LaunchDiscord_Click">
                        <Image Source="/Images/Messages.png" Width="17" Height="17"/>
            </Button>
        </UniformGrid>

        <!-- Footer: Configs & Quit -->
        <UniformGrid Columns="1"
                     Rows="2"
                     Grid.Column="0"
                     Grid.Row="6"
                     VerticalAlignment="Center"
                     Height="63">

            <RadioButton x:Name="ConfigsButton"
                         Style="{StaticResource IconRadioButton}"
                         Click="Configs_Click">
                             <Image Source="/Images/Configs.png" Width="15" Height="15"/>
            </RadioButton>

            <Button x:Name="QuitButton"
                    Style="{StaticResource IconButton}"
                    Click="CloseAppButton">
                        <Image Source="/Images/Quit.png" Width="15" Height="15"/>
            </Button>
        </UniformGrid>

        <!-- Selection Indicator -->
        <Grid x:Name="SelectionLayer"
              Grid.Column="0"
              Grid.RowSpan="7"
              Panel.ZIndex="100"
              IsHitTestVisible="False"
              Margin="10,0,0,0">

            <Border x:Name="SelectionIndicator"
                    Background="#FF0066"
                    Width="3"
                    Height="20"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="0"
                    RenderTransformOrigin="0.5,0.5">

                <Border.RenderTransform>
                    <TranslateTransform x:Name="SelectionTransform"/>
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Grid>
</UserControl>
