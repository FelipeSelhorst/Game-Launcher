<Window x:Class="Main_Window.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Main_Window"
        xmlns:controls="clr-namespace:Main_Window.Controls"
        mc:Ignorable="d"
        Icon="/Images/Logo.ico"
        Title="Slowpoke Launcher" Height="609" Width="801"
        Background="#0C0C0F" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Font Family -->
        <FontFamily x:Key="Montserrat">pack://application:,,,/Fonts/Montserrat-Regular.ttf</FontFamily>
        
        <!-- Main Buttons Style -->
        <Style x:Key="MainButtons" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border CornerRadius="10"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="White"
                                Background="{TemplateBinding Background}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF0066"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Profile Button Style -->
        <Style x:Key="ProfileButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ProfileBorder"
                                CornerRadius="25"
                                BorderThickness="2"
                                BorderBrush="White"
                                Background="{TemplateBinding Background}">
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ProfileBorder"
                                        Property="BorderBrush"
                                        Value="#FF0066"/>

                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ProfileBorder"
                                        Property="BorderBrush"
                                        Value="#FF0066"/>

                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Save Button Style -->
        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="170"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SaveBtnBorder"
                                CornerRadius="7"
                                BorderThickness="2"
                                BorderBrush="White"
                                Background="Transparent">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="SaveBtnBorder"
                                        Property="BorderBrush"
                                        Value="#FF0066"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar limitation -->
            <ColumnDefinition Width="62"
                              MinWidth="62"
                              MaxWidth="300"/>
            
            <ColumnDefinition Width="166"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="168"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <!-- Sidebar Rows -->
            <RowDefinition Height="70"/>
            <RowDefinition Height="59"/>
            <RowDefinition Height="94"/>
            <RowDefinition Height="94"/>
            <RowDefinition Height="94"/>
            <RowDefinition/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <!-- Sidebar Connection -->
        <controls:Sidebar Grid.Column="0" Grid.RowSpan="7"/>

        <!-- Vertical Bar -->
        <GridSplitter Grid.Column="0"
                      Grid.RowSpan="7"
                      Width="2"
                      Background="#1A1A1C"
                      ResizeDirection="Columns"
                      ResizeBehavior="CurrentAndNext"/>

        <!-- Main Content Definition -->
        <ContentControl x:Name="MainContent"
                        Grid.Column="1"
                        Grid.RowSpan="7"
                        Grid.ColumnSpan="5"/>

        <Grid>
            <!-- Main Content Rows -->
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="240"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        </Grid>

        <!-- MAIN CONTENT -->

        <!-- Top Message -->
        <TextBlock x:Name="TitleTextBlock"
                   Grid.Column="1"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="SemiBold"
                   FontFamily="Montserrat"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Text="Hello, User!"/>

        <!-- Patch Notes Button -->
        <RadioButton Grid.Column="2"
                     Grid.Row="0"
                     Content="Patch Notes"
                     HorizontalAlignment="Left"
                     Style="{StaticResource MainButtons}"
                     GroupName="MainButtons"/>
        
        <!-- Home Button -->
        <RadioButton Grid.Column="2"
                     Grid.Row="0"
                     Content="Home"
                     Style="{StaticResource MainButtons}"
                     GroupName="MainButtons"
                     IsChecked="True"/>

        <!-- Performance Button -->
        <RadioButton Grid.Column="2"
                     Grid.Row="0"
                     Content="Performance"
                     HorizontalAlignment="Right"
                     Style="{StaticResource MainButtons}"
                     GroupName="MainButtons"/>
        
        <!-- Profile Picture -->
        <ToggleButton x:Name="ProfileButton"
                      Click="ProfilePopUp"
                      Grid.Column="3"
                      Grid.Row="0"
                      HorizontalAlignment="Right"
                      Width="50"
                      Height="50"
                      Margin="0,0,30,0"
                      Style="{StaticResource ProfileButton}"/>

        <!-- Profile Picture Popup -->
        <Popup x:Name="ProfilePopup"
               PlacementTarget="{Binding ElementName=ProfileButton}"
               IsOpen="{Binding ElementName=ProfileButton, Path=IsChecked}"
               StaysOpen="False"
               AllowsTransparency="True">

            <Border Background="#0C0C0F"
                    BorderBrush="#FF0066"
                    BorderThickness="2"
                    Width="250"
                    Height="140"
                    CornerRadius="10">

                <!-- Popup Definitions -->
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="83"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <!-- Profile Picture -->
                    <Button x:Name="ProfilePicture"
                            Click="ChangeProfilePicture"
                            Grid.Column="0"
                            Grid.Row="0"
                            Width="70"
                            Height="70"
                            Grid.RowSpan="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <Image x:Name="ProfileImage" />
                    </Button>

                    <!-- Nickname -->
                    <TextBlock Foreground="White"
                               Text="Nickname"
                               Grid.Column="1"
                               Grid.Row="0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="7,0,0,0"
                               FontFamily="Montserrat"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <!-- Name Input -->
                    <Border Background="#1F1F27"
                            Grid.Column="1"
                            Grid.Row="1"
                            Width="133"
                            Height="26"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            CornerRadius="10">

                        <TextBox x:Name="NameInput"
                                 Foreground="White"
                                 Width="133"
                                 Height="26"
                                 Padding="5,0,0,0"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Montserrat"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Background="#1F1F27"/>
                    </Border>

                    <!-- Save Button -->
                    <Button x:Name="SaveButton"
                            Content="Save Changes"
                            Click="SaveProfile"
                            Grid.ColumnSpan="2"
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SaveButton}"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>