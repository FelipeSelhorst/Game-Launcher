<Window x:Class="Main_Window.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Main_Window"
        mc:Ignorable="d"
        Icon="/Images/Logo.ico"
        Title="Launcher" Height="609" Width="801"
        Background="#0C0C0F" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform x:Name="iconScale" ScaleX="1" ScaleY="1" CenterX="8.5" CenterY="8.5"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale" Storyboard.TargetProperty="ScaleX" To="1.2" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale" Storyboard.TargetProperty="ScaleY" To="1.2" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale" Storyboard.TargetProperty="ScaleX" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale" Storyboard.TargetProperty="ScaleY" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallIconButton" BasedOn="{StaticResource IconButton}" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="59"/>
            <RowDefinition Height="94"/>
            <RowDefinition Height="94"/>
            <RowDefinition Height="94"/>
            <RowDefinition/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <Grid Grid.Column="1" Grid.RowSpan="7">
            <ContentControl x:Name="MainContent"/>
        </Grid>

        <!-- Vertical Bar -->
        <GridSplitter Grid.Column="0"
                      Grid.RowSpan="7"
                      Width="2"
                      HorizontalAlignment="Right"
                      Background="#1A1A1C"
                      ResizeBehavior="CurrentAndNext"/>

        <!-- Logo -->
        <Image Grid.Column="0"
               Source="/Images/Logo.png"
               Margin="9,0,9,0"
               VerticalAlignment="Center" Height="90"/>

        <!-- Navigation Buttons -->
        <Button Grid.Column="0"
                Grid.Row="1"
                Margin="20,18,20,19"
                Style="{StaticResource IconButton}"
                Click="LaunchFirefox_Click">
            <Image Source="/Images/Search.png" Width="17.6" Height="17.6"/>
        </Button>

        <Border Background="#1A1A1C"
                BorderBrush="#1A1A1C"
                BorderThickness="1.5"
                Width="42"
                Height="3"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Grid.Row="1"
                Margin="0,56,0,0"/>

        <!-- Group 1: Home & Library-->
        <UniformGrid Columns="1" Rows="2" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" Height="78">
            <Button Style="{StaticResource IconButton}">
                <Image Source="/Images/Home.png" Width="17" Height="17"/>
            </Button>
            
            <Button Style="{StaticResource IconButton}">
                <Image Source="/Images/Library.png" Width="15" Height="15"/>
            </Button>
        </UniformGrid>

        <Border Background="#1A1A1C"
                BorderBrush="#1A1A1C"
                BorderThickness="1.5" Width="42"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Grid.Row="2" Height="3" Margin="0,91,0,0"/>

        <!-- Group 2: Shop & Wishlist -->
        <UniformGrid Columns="1" Rows="2" Grid.Column="0" Grid.Row="3" VerticalAlignment="Center" Height="78">
            <Button Style="{StaticResource IconButton}" Click="LaunchSteam_Click">
                <Image Source="/Images/Shop.png" Width="17" Height="17"/>
            </Button>
            
            <Button Style="{StaticResource IconButton}">
                <Image Source="/Images/Wishlist.png" Width="17" Height="17"/>
            </Button>
        </UniformGrid>

        <Border Background="#1A1A1C"
                BorderBrush="#1A1A1C"
                BorderThickness="1.5" Width="42"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Grid.Row="3" Height="3" Margin="0,91,0,0"/>

        <!-- Group 3: Friends & Messages -->
        <UniformGrid Columns="1" Rows="2" Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" Height="78">
            <Button Style="{StaticResource IconButton}">
                <Image Source="/Images/Friends.png" Width="17" Height="17"/>
            </Button>
           
            <Button Style="{StaticResource IconButton}"
                    Click="LaunchDiscord_Click">
                <Image Source="/Images/Messages.png" Width="17" Height="17"/>
            </Button>
        </UniformGrid>

        <!-- Footer: Configs & Quit -->
        <UniformGrid Columns="1" Rows="2" Grid.Column="0" Grid.Row="6" VerticalAlignment="Center" Height="63">
            <Button Style="{StaticResource IconButton}" Click="Configs_Click">
                <Image Source="/Images/Configs.png" Width="15" Height="15"/>
            </Button>

            <Button Style="{StaticResource IconButton}">
                <Image Source="/Images/Quit.png" Width="15" Height="15"/>
            </Button>
        </UniformGrid>
    </Grid>
</Window>