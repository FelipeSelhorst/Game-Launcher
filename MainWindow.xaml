<Window x:Class="Main_Window.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Main_Window"
        mc:Ignorable="d"
        Icon="/Images/Logo.ico"
        Title="Slowpoke Launcher" Height="609" Width="801"
        Background="#0C0C0F" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <FontFamily x:Key="Montserrat">pack://application:,,,/Fonts/Montserrat-Regular.ttf</FontFamily>
        
        <!-- Radio Button Style -->
        <Style x:Key="IconRadioButton" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform x:Name="iconScale"
                                                    ScaleX="1"
                                                    ScaleY="1"
                                                    CenterX="8.5"
                                                    CenterY="8.5"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.2" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.2" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style x:Key="IconButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">

                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform x:Name="iconScale"
                                        ScaleX="1"
                                        ScaleY="1"
                                        CenterX="8.5"
                                        CenterY="8.5"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.2" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.2" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallIconButton" BasedOn="{StaticResource IconButton}" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>

        <!-- Main Buttons Style -->
        <Style x:Key="MainButtons" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border CornerRadius="10"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="White"
                                Background="{TemplateBinding Background}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF0066"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62"/>
            <ColumnDefinition Width="166"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="168"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="59"/>
            <RowDefinition Height="94"/>
            <RowDefinition Height="94"/>
            <RowDefinition Height="94"/>
            <RowDefinition/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <Grid Grid.Column="1"
              Grid.RowSpan="7" Grid.ColumnSpan="5">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="240"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ContentControl x:Name="MainContent"/>
        </Grid>

        <!-- Vertical Bar -->
        <GridSplitter Grid.Column="0"
                      Grid.RowSpan="7"
                      Width="2"
                      Background="#1A1A1C"
                      ResizeBehavior="CurrentAndNext"/>

        <!-- Logo -->
        <Image Grid.Column="0"
               Source="/Images/Logo.png"
               Margin="9,0,9,0"
               VerticalAlignment="Center" Height="90"/>

        <!-- Navigation Buttons -->
        <Button Grid.Column="0"
                Grid.Row="1"
                Margin="20,18,17,16"
                Style="{StaticResource IconButton}"
                Click="LaunchFirefox_Click">
            <Image Source="/Images/Search.png" Width="17.6" Height="17.6"/>
        </Button>

        <Border Background="#1A1A1C"
                BorderBrush="#1A1A1C"
                BorderThickness="1.5"
                Width="42"
                Height="3"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Grid.Row="1"
                Margin="0,56,0,0"/>

        <!-- Group 1: Home & Library-->
        <UniformGrid Columns="1"
                     Rows="2" Grid.Column="0"
                     Grid.Row="2"
                     VerticalAlignment="Center"
                     Height="78">

            <RadioButton x:Name="HomeButton"
                    Style="{StaticResource IconRadioButton}"
                    Click="HomeButton_Click">
                <Image Source="/Images/Home.png" Width="17" Height="17"/>
            </RadioButton>

            <RadioButton x:Name="LibraryButton"
                    Style="{StaticResource IconRadioButton}"
                    Click="LibraryButton_Click">
                <Image Source="/Images/Library.png" Width="15" Height="15"/>
            </RadioButton>
        </UniformGrid>

        <Border Background="#1A1A1C"
                BorderBrush="#1A1A1C"
                BorderThickness="1.5" Width="42"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Grid.Row="2" Height="3" Margin="0,91,0,0"/>

        <!-- Group 2: Shop & Wishlist -->
        <UniformGrid Columns="1"
                     Rows="2"
                     Grid.Column="0"
                     Grid.Row="3"
                     VerticalAlignment="Center"
                     Height="78">

            <Button x:Name="ShopButton"
                    Style="{StaticResource IconButton}"
                    Click="LaunchSteam_Click">
                <Image Source="/Images/Shop.png" Width="17" Height="17"/>
            </Button>

            <Button x:Name="WishlistButton"
                    Style="{StaticResource IconButton}">
                <Image Source="/Images/Wishlist.png" Width="17" Height="17"/>
            </Button>
        </UniformGrid>

        <Border Background="#1A1A1C"
                BorderBrush="#1A1A1C"
                BorderThickness="1.5" Width="42"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Grid.Row="3" Height="3" Margin="0,91,0,0"/>

        <!-- Group 3: Friends & Messages -->
        <UniformGrid Columns="1"
                     Rows="2"
                     Grid.Column="0"
                     Grid.Row="4"
                     VerticalAlignment="Center"
                     Height="78">

            <Button x:Name="FriendsButton"
                    Style="{StaticResource IconButton}">
                <Image Source="/Images/Friends.png" Width="17" Height="17"/>
            </Button>

            <Button x:Name="MessagesButton"
                    Style="{StaticResource IconButton}"
                    Click="LaunchDiscord_Click">
                <Image Source="/Images/Messages.png" Width="17" Height="17"/>
            </Button>
        </UniformGrid>

        <!-- Footer: Configs & Quit -->
        <UniformGrid Columns="1"
                     Rows="2"
                     Grid.Column="0"
                     Grid.Row="6"
                     VerticalAlignment="Center"
                     Height="63">

            <RadioButton x:Name="ConfigsButton"
                    Style="{StaticResource IconRadioButton}"
                    Click="Configs_Click">
                <Image Source="/Images/Configs.png" Width="15" Height="15"/>
            </RadioButton>

            <Button x:Name="QuitButton"
                    Style="{StaticResource IconButton}"
                    Click="CloseAppButton">
                <Image Source="/Images/Quit.png" Width="15" Height="15"/>
            </Button>
        </UniformGrid>

        <!-- Selection Indicator -->
        <Grid x:Name="Sidebar"
              Grid.Column="0"
              Grid.RowSpan="7"
              Panel.ZIndex="100"
              IsHitTestVisible="False"
              Margin="10,0,0,0">

            <Border x:Name="SelectionIndicator"
                    Background="#FF0066"
                    Width="3"
                    Height="20"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="0"
                    RenderTransformOrigin="0.5,0.5">

                <Border.RenderTransform>
                    <TranslateTransform x:Name="SelectionTransform"/>
                </Border.RenderTransform>
            </Border>
        </Grid>

        <!-- Main Content -->

        <!-- Top Message -->
        <TextBlock Grid.Column="1"
                   Text="Hello, Felipe!"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="SemiBold"
                   FontFamily="Montserrat"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>

        <!-- Patch Notes Button -->
        <RadioButton Grid.Column="2"
                     Grid.Row="0"
                     Content="Patch Notes"
                     HorizontalAlignment="Left"
                     Style="{StaticResource MainButtons}"
                     GroupName="MainButtons"/>
        
        <!-- Home Button -->
        <RadioButton Grid.Column="2"
                     Grid.Row="0"
                     Content="Home"
                     Style="{StaticResource MainButtons}"
                     GroupName="MainButtons"
                     IsChecked="True"/>

        <!-- Performance Button -->
        <RadioButton Grid.Column="2"
                     Grid.Row="0"
                     Content="Performance"
                     HorizontalAlignment="Right"
                     Style="{StaticResource MainButtons}"
                     GroupName="MainButtons"/>
        
        <!-- Profile Picture -->

        <Button x:Name="ProfileButton"
                Click="ProfilePopUp"
                Grid.Column="3"
                Grid.Row="0"
                HorizontalAlignment="Right"
                Width="50"
                Height="50"
                Margin="0,0,30,0">
            <Image Source="/Images/PFP.png"/>
        </Button>

        <Popup x:Name="ProfilePopup"
               PlacementTarget="{Binding ElementName=ProfileButton}"
               StaysOpen="False"
               AllowsTransparency="True">
            
            <Border Background="#0C0C0F"
                    BorderBrush="#FF0066"
                    BorderThickness="2"
                    Width="230"
                    Height="80"
                    CornerRadius="10">

                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="63"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Image Source="/Images/PFP.png"
                           Grid.Column="0"
                           Grid.Row="0"
                           Width="48"
                           Grid.RowSpan="2"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>

                    <TextBlock Foreground="White"
                               Text="Name"
                               Grid.Column="1"
                               Grid.Row="0"
                               HorizontalAlignment="Left"
                               Margin="10,0,0,0"
                               FontFamily="Montserrat"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                    <Border Background="#1F1F27"
                            Grid.Column="1"
                            Grid.Row="1"
                            Width="133"
                            Height="26"
                            HorizontalAlignment="Left"
                            CornerRadius="10">
                        
                        <TextBox x:Name="NameInput"
                                 Foreground="Black"
                                 VerticalAlignment="Center"
                                 TextChanged="TextBox_TextChanged"
                                 Width="133"
                                 Height="26"
                                 Padding="5,0,0,0"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Montserrat"
                                 FontSize="14"
                                 FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>